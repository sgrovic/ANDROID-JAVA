<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/project_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_add_button"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back_24" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:letterSpacing="0.22"
                android:text="BUDGET PROJECT"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp" />
            <ImageButton
                android:id="@+id/project_more"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_add_button"
                android:contentDescription="Project options"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert_24" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:id="@+id/project_title"
            android:text="Project"
            android:textColor="?attr/colorOnSurface"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.72"
            android:includeFontPadding="false"
            android:text="See what's left after your plans."
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:includeFontPadding="false"
            android:text="Budget breakdown"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.68"
            android:text="See how income, fixed bills, and contributions are distributed across each cutoff."
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_row_item"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Equity"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="15th"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="30th"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/cutoffOutline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_tile">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Income"
                        android:src="@drawable/ic_wallet_24" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Income"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/project_first_salary"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/project_second_salary"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/cutoffOutline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_tile">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Fixed bills"
                        android:src="@drawable/ic_receipt_24"
                        android:tint="@color/project_negative" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Fixed bills"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/project_first_fixed"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/project_second_fixed"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/cutoffOutline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_tile">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Planned items"
                        android:src="@drawable/ic_calculator_24"
                        android:tint="@color/project_negative" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Planned"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/project_first_plan"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/project_second_plan"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:includeFontPadding="false"
            android:text="Projected balance"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.68"
            android:text="Estimated money left after fixed bills and project contributions."
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_project_balance_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="15th cutoff"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/project_first_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:textSize="27sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:alpha="0.7"
                    android:includeFontPadding="false"
                    android:text="left to spend"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/project_first_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    android:progressDrawable="@drawable/bg_progress_track" />

                <TextView
                    android:id="@+id/project_first_committed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:alpha="0.72"
                    android:includeFontPadding="false"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_project_balance_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="30th cutoff"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/project_second_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:textSize="27sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:alpha="0.7"
                    android:includeFontPadding="false"
                    android:text="left to spend"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/project_second_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    android:progressDrawable="@drawable/bg_progress_track" />

                <TextView
                    android:id="@+id/project_second_committed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:alpha="0.72"
                    android:includeFontPadding="false"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
            android:text="Contributions"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/project_plan_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_project_count_pill"
                android:includeFontPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_optimize_contributions"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Optimize contributions"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="9dp"
                android:text=""
                app:icon="@drawable/ic_auto_optimize_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="?attr/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add_planned_item"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:contentDescription="Add contribution"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:text="Add"
                android:textAllCaps="false"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                app:icon="@drawable/baseline_add_24"
                app:iconPadding="6dp"
                app:iconSize="22dp"
                app:iconTint="?attr/colorPrimary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.68"
            android:text="Set aside money for this project and balance it between your cutoffs."
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/project_plan_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_row_item"
            android:gravity="center"
            android:padding="18dp"
            android:text="No contributions yet."
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/project_plan_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
