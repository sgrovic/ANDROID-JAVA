<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <ImageButton android:id="@+id/button_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_arrow_back_24" android:contentDescription="Back to cutoffs" app:tint="?attr/colorOnSurface" />
    <TextView android:id="@+id/text_cutoff_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="This cutoff" android:textSize="12sp" android:textColor="?attr/colorOnSurface" android:layout_marginTop="12dp" />
    <TextView android:id="@+id/text_cutoff_period" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cutoff details" android:textSize="24sp" android:textColor="?attr/colorOnSurface" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" />
    <LinearLayout android:id="@+id/card_upcoming_cutoff" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_hero_card" android:padding="16dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Remaining after bills" android:textSize="12sp" android:textColor="?attr/colorOnSurface" />
      <TextView android:id="@+id/text_remaining_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="32sp" android:textColor="?attr/colorOnSurface" android:fontFamily="sans-serif-medium" android:layout_marginTop="6dp" android:layout_marginBottom="14dp" />
      <ProgressBar android:id="@+id/progress_spending" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progressDrawable="@drawable/bg_progress_track" />
      <TextView android:id="@+id/text_spending_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="?attr/colorOnSurface" android:layout_marginTop="8dp" />
    </LinearLayout>
    <TextView android:id="@+id/text_cutoff_scope" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Changes apply only to this cutoff." android:textSize="12sp" android:textColor="?attr/colorOnSurface" android:layout_marginTop="14dp" android:layout_marginBottom="16dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="4dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="12dp" android:paddingBottom="12dp">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Income" android:textSize="12sp" android:textColor="?attr/colorOnSurface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="salary + incentives" android:textSize="10sp" android:textColor="?attr/colorOnSurface" android:alpha="0.7" android:layout_marginTop="3dp" />
        <TextView android:id="@+id/text_salary_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="15sp" android:textColor="?attr/colorOnSurface" android:layout_marginTop="5dp" />
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp" android:paddingStart="4dp" android:paddingEnd="4dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total bills" android:textSize="12sp" android:textColor="?attr/colorOnSurface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="fixed + variable" android:textSize="10sp" android:textColor="?attr/colorOnSurface" android:alpha="0.7" android:layout_marginTop="3dp" />
        <TextView android:id="@+id/text_total_bill_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="15sp" android:textColor="?attr/colorOnSurface" android:layout_marginTop="5dp" />
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp" android:paddingStart="4dp" android:paddingEnd="4dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Remaining" android:textSize="12sp" android:textColor="?attr/colorOnSurface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="after bills" android:textSize="10sp" android:textColor="?attr/colorOnSurface" android:alpha="0.7" android:layout_marginTop="3dp" />
        <TextView android:id="@+id/text_summary_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="15sp" android:textColor="?attr/colorOnSurface" android:layout_marginTop="5dp" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
      <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Incentives" android:textColor="?attr/colorOnSurface" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
      <com.google.android.material.button.MaterialButton android:id="@+id/button_add_incentive" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Add" android:textAllCaps="false" app:icon="@drawable/baseline_add_24" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Extra income for this cutoff" android:textSize="12sp" android:textColor="?attr/colorOnSurface" android:layout_marginBottom="12dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_incentives" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
      <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Bills" android:textColor="?attr/colorOnSurface" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
      <com.google.android.material.button.MaterialButton android:id="@+id/button_add_fixed_bill" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Add" android:textAllCaps="false" app:icon="@drawable/baseline_add_24" />
      <com.google.android.material.button.MaterialButton android:id="@+id/button_add_variable_bill" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Add" android:textAllCaps="false" android:visibility="gone" app:icon="@drawable/baseline_add_24" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/bill_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_icon_tile" android:padding="4dp" app:checkedButton="@id/tab_fixed_bills" app:selectionRequired="true" app:singleSelection="true">
      <com.google.android.material.button.MaterialButton android:id="@+id/tab_fixed_bills" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:fontFamily="sans-serif" android:insetTop="0dp" android:insetBottom="0dp" android:text="Fixed bills" android:textAllCaps="false" android:textSize="13sp" app:backgroundTint="@color/cutoff_tab_fill" app:cornerRadius="9dp" app:strokeWidth="0dp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/tab_variable_bills" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:fontFamily="sans-serif" android:insetTop="0dp" android:insetBottom="0dp" android:text="Variable bills" android:textAllCaps="false" android:textSize="13sp" app:backgroundTint="@color/cutoff_tab_fill" app:cornerRadius="9dp" app:strokeWidth="0dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <TextView android:id="@+id/text_bill_tab_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Copied from templates · Editable for this cutoff" android:textSize="12sp" android:textColor="?attr/colorOnSurface" android:alpha="0.72" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_fixed_bills" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_variable_bills" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:visibility="gone" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
