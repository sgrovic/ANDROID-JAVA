<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/input_plan_name"
        android:text="Contribution name"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/input_plan_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="e.g. Monthly contribution"
        android:inputType="textCapSentences"
        android:minHeight="52dp"
        android:padding="14dp"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:labelFor="@id/input_plan_amount"
        android:text="Amount per month"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/input_plan_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="0.00"
        android:inputType="numberDecimal"
        android:minHeight="52dp"
        android:padding="14dp"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Apply every"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/input_plan_cutoff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:checkedButton="@id/radio_plan_both"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radio_plan_first"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="15th"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/radio_plan_second"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="30th"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/radio_plan_both"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:checked="true"
            android:text="Both"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/plan_split_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_project_balance_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Split contribution"
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:alpha="0.7"
            android:text="Choose how to divide the amount between cutoffs."
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Split ratio"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/plan_first_percent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="15th • 50%"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/plan_second_percent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="30th • 50%"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/input_plan_ratio_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Contribution split percentage"
            android:stepSize="1"
            android:value="50"
            android:valueFrom="0"
            android:valueTo="100" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:orientation="horizontal"
            android:padding="14dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15th"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/plan_first_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="₱0"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="18sp" />
            </LinearLayout>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="?attr/cutoffOutline" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30th"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/plan_second_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="₱0"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
