<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText android:background="@drawable/bg_input" android:padding="16dp" android:minHeight="56dp" android:textSize="16sp"
        android:id="@+id/input_first_to_fifteenth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="1st to 15th" />

    <EditText android:background="@drawable/bg_input" android:padding="16dp" android:minHeight="56dp" android:textSize="16sp"
        android:id="@+id/input_sixteenth_to_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:inputType="numberDecimal"
        android:hint="16th to end" />

</LinearLayout>
